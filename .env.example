# Copy to .env and fill in. Never commit .env.
# During `shopify app dev`, the Shopify CLI injects SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES automatically. Set them
# yourself only in production (see README > Deployment).

# --- Shopify (production only; CLI provides these in development)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# --- Database (PostgreSQL). Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalog_copilot

# --- AI provider (used from Phase 3; server-side only, never exposed to the browser)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
