# Copy to .env and fill in. Never commit .env.
# During `shopify app dev`, the Shopify CLI injects SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES automatically. Set them
# yourself only in production (see README > Deployment).

# --- Shopify (production only; CLI provides these in development)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products

# --- Database (PostgreSQL). Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalog_copilot

# --- AI provider (server-side only, never exposed to the browser)
# "groq" (free tier, https://console.groq.com/keys), "anthropic", or
# "mock" (labelled placeholder output for local testing, no key needed)
AI_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: openai/gpt-oss-120b (groq), claude-opus-5-5 (anthropic)
AI_MODEL=
